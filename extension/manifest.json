{
  "manifest_version": 2,
  "name": "Claude Browser Bridge",
  "version": "1.0.2",
  "description": "Lets the local Claude desktop app drive this browser through a localhost MCP bridge.",
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-ff-bridge@sysadmin.local",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["tabs", "activeTab", "<all_urls>", "storage", "clipboardWrite"],
  "background": { "scripts": ["background.js"], "persistent": true },
  "browser_action": {
    "default_title": "Claude Browser Bridge",
    "default_popup": "popup.html",
    "default_icon": { "48": "icons/icon-48.png", "96": "icons/icon-96.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "icons": { "48": "icons/icon-48.png", "96": "icons/icon-96.png" }
}
